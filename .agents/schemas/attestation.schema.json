{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnntransfer.dev/schemas/harness-v2/attestation.schema.json",
  "title": "Harness V2 attestations",
  "oneOf": [
    {
      "$ref": "#/$defs/gate"
    },
    {
      "$ref": "#/$defs/acceptance"
    },
    {
      "$ref": "#/$defs/closure"
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gate_id",
        "source_sha",
        "source_tree",
        "command_sha256",
        "policy_sha256",
        "toolchain_sha256",
        "environment_sha256",
        "platform",
        "isolation_mode",
        "cache_key",
        "executed_phase",
        "started_at",
        "duration_ns",
        "outcome",
        "skipped",
        "exit_code",
        "output_sha256",
        "output_bytes",
        "reused_from_source_sha"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_sha": {
          "$ref": "#/$defs/sha"
        },
        "source_tree": {
          "$ref": "#/$defs/sha"
        },
        "command_sha256": {
          "$ref": "#/$defs/digest"
        },
        "policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "toolchain_sha256": {
          "$ref": "#/$defs/digest"
        },
        "environment_sha256": {
          "$ref": "#/$defs/digest"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "isolation_mode": {
          "type": "string",
          "minLength": 1
        },
        "cache_key": {
          "$ref": "#/$defs/digest"
        },
        "executed_phase": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "skipped",
            "timeout",
            "crash",
            "output_limit",
            "error"
          ]
        },
        "skipped": {
          "type": "boolean"
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "output_sha256": {
          "$ref": "#/$defs/digest"
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "reused_from_source_sha": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha"
            }
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "submission_sha256",
        "candidate_sha",
        "candidate_tree",
        "integration_base",
        "payload_patch_sha256",
        "workflow",
        "required_jobs",
        "required_artifacts",
        "required_gate_attestations",
        "criterion_evidence",
        "skipped_jobs",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^XT-[0-9]{3,}$"
        },
        "submission_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha": {
          "$ref": "#/$defs/sha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/sha"
        },
        "integration_base": {
          "$ref": "#/$defs/sha"
        },
        "payload_patch_sha256": {
          "$ref": "#/$defs/digest"
        },
        "workflow": {
          "type": "object"
        },
        "required_jobs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "required_artifacts": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "required_gate_attestations": {
          "$ref": "#/$defs/digests"
        },
        "criterion_evidence": {
          "$ref": "#/$defs/digests"
        },
        "skipped_jobs": {
          "type": "array",
          "maxItems": 0
        },
        "created_by": {
          "type": "object"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "plan_id",
        "plan_content_sha256",
        "criteria",
        "protected_head",
        "dependencies",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^XT-[0-9]{3,}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^DP-[A-Z0-9-]+$"
        },
        "plan_content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "criteria": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "protected_head": {
          "$ref": "#/$defs/sha"
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "published_sha",
              "acceptance_ref",
              "acceptance_sha256",
              "criteria"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^XT-[0-9]{3,}$"
              },
              "published_sha": {
                "$ref": "#/$defs/sha"
              },
              "acceptance_ref": {
                "type": "string",
                "pattern": "^refs/heads/attest/acceptance/"
              },
              "acceptance_sha256": {
                "$ref": "#/$defs/digest"
              },
              "criteria": {
                "$ref": "#/$defs/nonEmptyStrings"
              }
            }
          }
        },
        "created_by": {
          "type": "object"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
