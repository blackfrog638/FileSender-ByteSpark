{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnntransfer.dev/schemas/harness-v2/project-approval.schema.json",
  "title": "XnnTransfer Project Model Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approved_by",
    "approved_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
