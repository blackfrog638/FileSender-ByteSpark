{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnntransfer.dev/schemas/harness-v2/manifest.schema.json",
  "title": "Harness V2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_version",
    "project",
    "integration_branch",
    "queue_namespace"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness_version": {
      "const": 2
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1
    },
    "queue_namespace": {
      "type": "string",
      "pattern": "^refs/heads/queue/.+/$|^refs/heads/queue/$"
    }
  }
}
