{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnntransfer.dev/schemas/harness-v2/composition-baseline.schema.json",
  "title": "XnnTransfer Project Composition Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "state",
        "basis"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "state": {
          "enum": [
            "absent",
            "specified",
            "implemented",
            "qualified"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
