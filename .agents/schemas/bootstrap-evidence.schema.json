{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnntransfer.dev/schemas/harness-v2/bootstrap-evidence.schema.json",
  "title": "Harness V2 bootstrap cutover evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_sha",
    "source_tree",
    "platform",
    "plan_sha256",
    "gate_ids",
    "gate_attestations",
    "skipped"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "bootstrap_cutover"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platform": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "gate_attestations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "skipped": {
      "const": false
    }
  }
}
