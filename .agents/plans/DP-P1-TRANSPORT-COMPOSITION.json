{
  "schema_version": 2,
  "id": "DP-P1-TRANSPORT-COMPOSITION",
  "title": "P1 transport composition contracts",
  "status": "approved",
  "source": {
    "kind": "roadmap",
    "path": "docs/roadmap.md"
  },
  "requirements": [
    {
      "id": "REQ-P1-TRANSPORT-COMPOSITION-CONTRACT",
      "source_ref": "RM-P1-ONE-FILE-TRANSFER",
      "statement": "Define the interoperable transport-binding inputs and authorized channel ownership handoff required to compose authenticated connections with the one-file transfer engine.",
      "criteria": [
        {
          "id": "CRIT-P1-TRANSPORT-CONTEXT-EXCHANGE",
          "statement": "Each provisional established connection validates role-ordered fresh 32-octet session nonces and one initiator-selected nonzero 16-octet transfer session identifier from normative v1 HELLO fields, binds their exact raw transcript and normalized negotiation into ADR 0002, and rejects transfer frames until both TRANSPORT_FINISHED conditions hold.",
          "negative_definitions": [
            "Missing, duplicate, malformed, zero, role-swapped, or reused profile-context values do not establish a protected transport.",
            "Discovery metadata, process constants, local-only values, undocumented noncritical fields, or a TLS handshake without the ADR 0002 finished exchange do not supply the transport context.",
            "A parser-only success, exact peer pin, or encrypted transfer frame received before transport binding does not authorize metadata or file dispatch."
          ],
          "implementation_tasks": [
            "XT-093",
            "XT-094"
          ],
          "evidence": [
            {
              "id": "EVD-P1-TRANSPORT-CONTEXT-NATIVE",
              "producer_task": "XT-093",
              "gate": "native_test",
              "level": "contract",
              "required_scenarios": [
                "transport_context.valid_role_order",
                "transport_context.fragmented_frames",
                "transport_context.invalid_profile_inputs",
                "transport_context.prebinding_transfer"
              ],
              "required_assertions": [
                "transcript.exact_bytes_bound",
                "profile_inputs.fresh_and_role_scoped",
                "prebinding.dispatch_rejected",
                "fatal_input.closes_connection"
              ],
              "required_platforms": [],
              "required_roles": [
                "initiator",
                "responder"
              ],
              "topology": "in_process",
              "allow_skipped": false
            },
            {
              "id": "EVD-P1-TRANSPORT-CONTEXT-SECURITY",
              "producer_task": "XT-093",
              "gate": "security_test",
              "level": "security",
              "required_scenarios": [
                "transport_context.replay",
                "transport_context.role_swap",
                "transport_context.transcript_tamper"
              ],
              "required_assertions": [
                "replay.rejected",
                "role_swap.rejected",
                "tamper.rejected_without_fallback"
              ],
              "required_platforms": [],
              "required_roles": [
                "initiator",
                "responder"
              ],
              "topology": "in_process",
              "allow_skipped": false
            },
            {
              "id": "EVD-P1-TRANSPORT-NORMALIZATION-SESSION",
              "producer_task": "XT-094",
              "gate": "native_test",
              "level": "contract",
              "required_scenarios": [
                "transport_context.normalize_negotiation",
                "transport_context.reject_noncanonical_selection"
              ],
              "required_assertions": [
                "normalization.matches_security_profile",
                "noncanonical_selection.rejected"
              ],
              "required_platforms": [],
              "required_roles": [
                "initiator",
                "responder"
              ],
              "topology": "in_process",
              "allow_skipped": false
            }
          ]
        },
        {
          "id": "CRIT-P1-SESSION-AUTHORITY-HANDOFF",
          "statement": "A connection transfers its transport-bound EstablishedTlsChannel exactly once into SessionAuthority, returns an authorized SessionHandle while the TLS byte stream remains alive, and deactivates that handle before normal close, failure, runtime stop, or destruction completes.",
          "negative_definitions": [
            "A borrowed channel reference, copied identity, active peer record, or synthetic SessionHandle does not satisfy authorization.",
            "Activation before both transport-finished conditions, repeated activation, stale identity revision, revocation, or activation after shutdown fails without leaking channel ownership.",
            "Closing the socket before SessionAuthority deactivation, retaining authorization after disconnect, or invoking callbacks after the stop barrier violates the criterion."
          ],
          "implementation_tasks": [
            "XT-094"
          ],
          "evidence": [
            {
              "id": "EVD-P1-SESSION-AUTHORITY-NATIVE",
              "producer_task": "XT-094",
              "gate": "native_test",
              "level": "integration",
              "required_scenarios": [
                "session_authority.activate_bound_channel",
                "session_authority.reject_invalid_activation",
                "session_authority.disconnect_cleanup",
                "session_authority.shutdown_race"
              ],
              "required_assertions": [
                "activation.exactly_once",
                "handle.authorizes_transfer_context",
                "disconnect.deactivates_before_teardown",
                "shutdown.no_late_callbacks"
              ],
              "required_platforms": [
                "linux",
                "macos",
                "windows"
              ],
              "required_roles": [
                "initiator",
                "responder"
              ],
              "topology": "in_process",
              "allow_skipped": false
            },
            {
              "id": "EVD-P1-SESSION-AUTHORITY-SECURITY",
              "producer_task": "XT-094",
              "gate": "security_test",
              "level": "security",
              "required_scenarios": [
                "session_authority.prebinding_activation",
                "session_authority.revocation_race",
                "session_authority.stop_race"
              ],
              "required_assertions": [
                "prebinding.rejected",
                "revocation.invalidates_handle",
                "race.no_leak_or_double_release"
              ],
              "required_platforms": [],
              "required_roles": [
                "initiator",
                "responder"
              ],
              "topology": "in_process",
              "allow_skipped": false
            }
          ]
        }
      ],
      "acceptance_task": "XT-095"
    }
  ],
