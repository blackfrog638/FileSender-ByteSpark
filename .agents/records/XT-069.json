  "risks": {
    "functionality": {
      "level": "critical",
      "rationale": "The runtime must turn completed TLS and pairing primitives into real connections without inventing identity, session, or transcript state.",
      "gates": [
        "native_test",
        "security_test",
        "verify"
      ]
    },
    "security": {
      "level": "critical",
      "rationale": "ALPN confusion, unpinned established channels, malformed certificates, or discovery-derived identity would break the accepted pairing security profile.",
      "gates": [
        "native_test",
        "security_test",
        "verify"
      ]
    },
    "performance": {
      "level": "medium",
      "rationale": "Handshake, frame assembly, timers, and connection limits must remain bounded under slow or hostile peers.",
      "gates": [
        "native_test",
        "security_test"
      ]
    },
    "compatibility": {
      "level": "high",
      "rationale": "Both registered ALPN modes and existing TLS, session, and identity contracts must remain wire and source compatible.",
      "gates": [
        "native_test",
        "verify"
      ]
    },
    "concurrency": {
      "level": "critical",
      "rationale": "Socket, SSL, timer, executor, session callback, and engine shutdown lifetimes race across asynchronous completion.",
      "gates": [
        "native_test",
        "security_test"
      ]
    },
    "platform": {
      "level": "high",
      "rationale": "Asio socket and OpenSSL lifecycle behavior must hold across macOS, Windows, and Linux production builds.",
      "gates": [
        "native_test",
        "verify"
      ]
    },
    "persistence": {
      "level": "high",
      "rationale": "Inbound exact-pin resolution and trust commit consume protected identity records and must fail closed on unavailable or corrupt storage.",
      "gates": [
        "native_test",
        "security_test"
      ]
    }
  },
