  "risks": {
    "functionality": {
      "level": "high",
      "rationale": "False negatives permit overlapping work or stale delivery, while false positives unnecessarily serialize independent tasks.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "security": {
      "level": "high",
      "rationale": "A stale task could review under obsolete governance or overwrite a security-sensitive fix in an overlapping path.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "performance": {
      "level": "low",
      "rationale": "Claim, review, and integration add bounded record and Git diff scans over the tracked task catalogue.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "compatibility": {
      "level": "medium",
      "rationale": "Existing schema versions, non-overlapping tasks, custom base refs, and archived task records must retain their legal workflows.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "concurrency": {
      "level": "critical",
      "rationale": "Two simultaneous claims must not both pass an overlap check, and an interrupted claimant must not leave a permanent scheduler lock.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "platform": {
      "level": "low",
      "rationale": "Pattern matching, Git ancestry, and lock recovery must behave consistently on supported development hosts.",
      "gates": [
        "governance_test",
        "verify"
      ]
    },
    "persistence": {
      "level": "medium",
      "rationale": "Claim locks live in the common Git directory and must recover after process termination without entering tracked history.",
      "gates": [
        "governance_test",
        "verify"
      ]
    }
  },
