      ]
    },
    "performance": {
      "level": "none",
      "rationale": "The check reads one small blob and one commit path list per governed commit.",
      "gates": []
    },
    "compatibility": {
      "level": "medium",
      "rationale": "The initial activation and pre-policy history must remain valid while later policy changes are rejected.",
      "gates": [
        "commit_message_test",
        "verify"
      ]
    },
    "concurrency": {
      "level": "none",
      "rationale": "Validation reads immutable commit objects and introduces no shared mutable state.",
      "gates": []
    },
    "platform": {
      "level": "low",
      "rationale": "Git blob and diff-tree queries must behave consistently across supported development hosts.",
      "gates": [
        "commit_message_test",
        "verify"
      ]
    },
    "persistence": {
      "level": "low",
      "rationale": "The change makes the committed identity policy a permanent repository trust root.",
      "gates": [
        "commit_message_test",
        "verify"
      ]
    }
  },
